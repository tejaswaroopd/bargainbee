# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/bargainbee"

# JWT
# SECURITY: In production, use a cryptographically random secret (64+ hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app will refuse to start in production with the default value.
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# FEATURE 1 — Login Rate Limiting
# Max failed login attempts per IP before lockout (default: 5)
LOGIN_MAX_ATTEMPTS=5
# Sliding window in minutes (default: 15)
LOGIN_WINDOW_MINUTES=15

# FEATURE 2 — AES-256-GCM Encryption Key (voucher codes at rest)
# REQUIRED in production. Must be exactly 64 hex characters (32 bytes = 256-bit key).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key will make existing encrypted voucher codes unreadable.
#          Always back up the key securely before rotating it.
ENCRYPTION_KEY_HEX=your_64_character_hex_encryption_key_here_generate_with_command_above

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Razorpay (get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase Storage (optional - for voucher image uploads)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Email (optional - for notifications and FEATURE 6 verification OTPs)
# If not configured, OTPs and emails are logged to the console (dev-safe).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=BargainBee <noreply@bargainbee.in>

# Platform defaults
COMMISSION_PERCENT=5
PRIORITY_VERIFICATION_FEE=99
